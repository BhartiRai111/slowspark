# Copy this file to .env and fill in the values.

# Backend URL. On a real phone use your laptop's Wi-Fi IP, e.g. http://192.168.1.5:8080
EXPO_PUBLIC_API_URL=http://192.168.1.5:8080

# Firebase console → Authentication → Sign-in method → Google → "Web client ID"
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Cloudinary (free account) → Settings → Upload → add an UNSIGNED upload preset
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Required by Play Store for dating apps: public pages for privacy policy & terms, and a support email
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=

# true = show "Dev login" button (works only if backend has DEV_LOGIN_ENABLED=true)
EXPO_PUBLIC_DEV_LOGIN=true
